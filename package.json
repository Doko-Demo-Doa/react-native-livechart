{
  "name": "react-native-livechart-expo-example",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:graph:skia": "EXPO_PUBLIC_RN_GRAPH_BACKEND=skia expo start --clear",
    "start:graph:tgfx": "EXPO_PUBLIC_RN_GRAPH_BACKEND=tgfx expo start --clear",
    "start:graph:thor": "EXPO_PUBLIC_RN_GRAPH_BACKEND=thor expo start --clear",
    "ios:graph:skia": "EXPO_PUBLIC_RN_GRAPH_BACKEND=skia expo run:ios",
    "ios:graph:tgfx": "EXPO_PUBLIC_RN_GRAPH_BACKEND=tgfx expo run:ios",
    "ios:graph:thor": "EXPO_PUBLIC_RN_GRAPH_BACKEND=thor expo run:ios",
    "android:graph:skia": "EXPO_PUBLIC_RN_GRAPH_BACKEND=skia expo run:android",
    "android:graph:tgfx": "EXPO_PUBLIC_RN_GRAPH_BACKEND=tgfx expo run:android",
    "android:graph:thor": "EXPO_PUBLIC_RN_GRAPH_BACKEND=thor expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:lib": "jest packages/react-native-livechart",
    "test:coverage": "jest --coverage",
    "benchmark:threshold-shader": "node scripts/benchmark-threshold-shader.mjs",
    "build:lib": "npm run build -w react-native-livechart",
    "build:lib:types:watch": "npm run build:types:watch -w react-native-livechart",
    "pack:lib": "npm pack -w react-native-livechart",
    "verify:bundle-mode-consumer": "node scripts/verify_bundle_mode_consumer.mjs",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:coverage": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepare": "husky",
    "postinstall": "patch-package",
    "doctor": "npx react-doctor@latest",
    "docs": "cd docs && npx mint@latest dev"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/list": "^3.0.4",
    "@shopify/react-native-skia": "2.6.4",
    "@types/jest": "29.5.14",
    "expo": "^57.0.1",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-graph": "1.4.0-alpha.1",
    "react-native-livechart": "file:packages/react-native-livechart",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-thor": "0.0.2-alpha.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-tgfx": "0.0.2-alpha.12",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@testing-library/react-native": "^14.0.0",
    "@types/node": "26.5.1",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "react-doctor": "^0.9.0",
    "react-test-renderer": "19.2.3",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-native/jest-preset": "0.86.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    }
  }
}
